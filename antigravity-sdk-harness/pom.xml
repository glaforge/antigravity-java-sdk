<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.glaforge.antigravity</groupId>
        <artifactId>antigravity-sdk-parent</artifactId>
        <version>${revision}</version>
    </parent>

    <artifactId>antigravity-sdk-harness</artifactId>
    <name>Antigravity Java SDK - Harness Binaries</name>
    <description>Platform-specific native localharness Go binaries for offline deployment.</description>
    <url>https://github.com/glaforge/antigravity-java-sdk</url>



    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.4.1</version>
                <executions>
                    <execution>
                        <id>jar-linux-x86_64</id>
                        <goals>
                            <goal>jar</goal>
                        </goals>
                        <configuration>
                            <classifier>linux-x86_64</classifier>
                            <includes>
                                <include>google/antigravity/bin/linux-x86_64/**</include>
                            </includes>
                        </configuration>
                    </execution>
                    <execution>
                        <id>jar-linux-aarch64</id>
                        <goals>
                            <goal>jar</goal>
                        </goals>
                        <configuration>
                            <classifier>linux-aarch64</classifier>
                            <includes>
                                <include>google/antigravity/bin/linux-aarch64/**</include>
                            </includes>
                        </configuration>
                    </execution>
                    <execution>
                        <id>jar-osx-aarch64</id>
                        <goals>
                            <goal>jar</goal>
                        </goals>
                        <configuration>
                            <classifier>osx-aarch64</classifier>
                            <includes>
                                <include>google/antigravity/bin/osx-aarch64/**</include>
                            </includes>
                        </configuration>
                    </execution>
                    <execution>
                        <id>jar-osx-x86_64</id>
                        <goals>
                            <goal>jar</goal>
                        </goals>
                        <configuration>
                            <classifier>osx-x86_64</classifier>
                            <includes>
                                <include>google/antigravity/bin/osx-x86_64/**</include>
                            </includes>
                        </configuration>
                    </execution>
                    <execution>
                        <id>jar-windows-x86_64</id>
                        <goals>
                            <goal>jar</goal>
                        </goals>
                        <configuration>
                            <classifier>windows-x86_64</classifier>
                            <includes>
                                <include>google/antigravity/bin/windows-x86_64/**</include>
                            </includes>
                        </configuration>
                    </execution>
                    <execution>
                        <id>jar-windows-aarch64</id>
                        <goals>
                            <goal>jar</goal>
                        </goals>
                        <configuration>
                            <classifier>windows-aarch64</classifier>
                            <includes>
                                <include>google/antigravity/bin/windows-aarch64/**</include>
                            </includes>
                        </configuration>
                    </execution>
                    <execution>
                        <id>jar-all</id>
                        <goals>
                            <goal>jar</goal>
                        </goals>
                        <configuration>
                            <classifier>all</classifier>
                            <includes>
                                <include>google/antigravity/bin/**</include>
                            </includes>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <id>deployment</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>sync-harness-binaries</id>
                                <phase>generate-resources</phase>
                                <goals>
                                    <goal>exec</goal>
                                </goals>
                                <configuration>
                                    <executable>bash</executable>
                                    <arguments>
                                        <argument>${maven.multiModuleProjectDirectory}/sync-harness.sh</argument>
                                    </arguments>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
